        {
            "name": "Python: Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python: Local",
            "type": "python",
            "request": "launch",
            "program": "local.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Mem Profile: Local Dev",
            "type": "python",
            "request": "launch",
            "program": "local.py",
            "console": "integratedTerminal",
            "pythonArgs": ["-m memory_profiler"]
        }
     
    ]
}